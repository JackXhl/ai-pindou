---
import { BEAD_UNITS, BOARD_PRESETS, SIZE_PRESETS, describeSize } from '@aipindou/registry';
import type { BeadUnitId } from '@aipindou/registry';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ROUTES, absolute } from '../../lib/url.js';

export function getStaticPaths() {
  return (Object.keys(BEAD_UNITS) as BeadUnitId[]).map((mm) => ({
    params: { mm },
  }));
}

const { mm } = Astro.params;
if (!mm || !(mm in BEAD_UNITS)) throw new Error(`未知豆径：${mm}`);

const unitId = mm as BeadUnitId;
const unit = BEAD_UNITS[unitId];
const title = `${unit.label}拼豆规格说明`;
const description = `${unit.label}（直径 ${unit.widthMm}mm）的格数、成品厘米与底板数换算，方便下单前估算材料。`;

const samples = SIZE_PRESETS.map((p) =>
  describeSize(p.cols, p.rows, unit, BOARD_PRESETS[0]),
);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description,
  url: absolute(ROUTES.size(mm)),
};
---

<BaseLayout title={title} description={description} structuredData={structuredData}>
  <SiteHeader />

  <main class="mx-auto max-w-3xl px-4 py-12">
    <p class="m-0 text-sm text-[var(--surface-text-muted)]">
      <a href={ROUTES.home()} class="underline">首页</a>
      / 规格
    </p>
    <h1 class="mt-2 text-3xl">{title}</h1>
    <p class="mt-3 text-[var(--surface-text-muted)]">{description}</p>

    <dl class="mt-8 grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
      <dt class="text-[var(--surface-text-muted)]">豆径</dt>
      <dd class="tabular m-0">{unit.widthMm} mm</dd>
      <dt class="text-[var(--surface-text-muted)]">形状</dt>
      <dd class="m-0">{unit.shape === 'circle' ? '圆形（有孔）' : '方形'}</dd>
      <dt class="text-[var(--surface-text-muted)]">常用底板</dt>
      <dd class="m-0">{BOARD_PRESETS[0]!.label}</dd>
    </dl>

    <h2 class="mt-10 text-xl">常见成品尺寸</h2>
    <p class="mt-2 text-sm text-[var(--surface-text-muted)]">
      格数 × 豆径 = 物理边长；底板数按 {BOARD_PRESETS[0]!.cols}×{BOARD_PRESETS[0]!.rows} 向上取整。
    </p>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full min-w-[28rem] border-collapse text-sm">
        <thead>
          <tr class="border-b border-[var(--surface-border)] text-left">
            <th class="py-2 pr-3 font-medium">格数</th>
            <th class="py-2 pr-3 font-medium">成品尺寸</th>
            <th class="py-2 pr-3 font-medium">豆数</th>
            <th class="py-2 font-medium">底板</th>
          </tr>
        </thead>
        <tbody>
          {
            samples.map((s) => (
              <tr class="border-b border-[var(--surface-border)]">
                <td class="tabular py-2 pr-3">
                  {s.cols}×{s.rows}
                </td>
                <td class="tabular py-2 pr-3">
                  {s.widthCm}×{s.heightCm} cm
                </td>
                <td class="tabular py-2 pr-3">{s.beads}</td>
                <td class="tabular py-2">{s.boards} 块</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="mt-6 text-sm text-[var(--surface-text-muted)]">
      国内零售主流多为 2.6mm；英文工具常默认 5mm。选错豆径会把底板数算错。
      {
        unitId === '2.6mm' ? (
          <>
            {' '}
            也可查看
            <a href={ROUTES.size('5mm')} class="underline">
              5mm 规格
            </a>
            。
          </>
        ) : (
          <>
            {' '}
            也可查看
            <a href={ROUTES.size('2.6mm')} class="underline">
              2.6mm 规格
            </a>
            。
          </>
        )
      }
    </p>

    <div class="mt-10">
      <a
        href={ROUTES.editor()}
        class="inline-block rounded-[var(--radius-control)] bg-brand-500 px-5 py-2.5 text-white no-underline"
      >
        按此规格开始做图
      </a>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
